generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model client {
  id          Int               @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  membership  client_membership @default(BASIC)
  notes       String?
  visitsCount Int               @default(0)
  totalSpent  Decimal           @default(0.00) @db.Decimal(10, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  motorcycle  motorcycle[]
  reminder    reminder[]
  workorder   workorder[]
}

model motorcycle {
  id                  Int             @id @default(autoincrement())
  clientId            Int
  brand               String
  model               String
  year                Int?
  plate               String?
  color               String?
  vin                 String?
  type                motorcycle_type @default(MOTO)
  mileageKm           Int?
  hoursUsed           Int?
  nextMaintenanceDate DateTime?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  client              client          @relation(fields: [clientId], references: [id], map: "Motorcycle_clientId_fkey")
  reminder            reminder[]
  workorder           workorder[]

  @@index([clientId, type], map: "idx_motorcycle_client_type")
}

model promotion {
  id            Int                   @id @default(autoincrement())
  name          String
  description   String?
  visitNumber   Int?
  minVisits     Int?
  minTotalSpent Decimal?              @db.Decimal(10, 2)
  benefitType   promotion_benefitType
  benefitValue  Decimal?              @db.Decimal(10, 2)
  freeServiceId Int?
  startDate     DateTime
  endDate       DateTime
  priority      Int                   @default(1)
  accumulable   Boolean               @default(false)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt
  ruleId        Int
  service       service?              @relation(fields: [freeServiceId], references: [id], map: "Promotion_freeServiceId_fkey")
  promotionrule promotionrule         @relation(fields: [ruleId], references: [id], map: "Promotion_ruleId_fkey")

  @@index([freeServiceId], map: "Promotion_freeServiceId_fkey")
  @@index([ruleId], map: "Promotion_ruleId_fkey")
}

model promotionrule {
  id             Int         @id @default(autoincrement())
  name           String
  key            String      @unique(map: "PromotionRule_key_key")
  conditionLabel String
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  promotion      promotion[]
}

model reminder {
  id           Int              @id @default(autoincrement())
  clientId     Int
  motorcycleId Int
  serviceId    Int?
  targetDate   DateTime
  channel      reminder_channel
  status       reminder_status  @default(PENDIENTE)
  sentAt       DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  client       client           @relation(fields: [clientId], references: [id], map: "Reminder_clientId_fkey")
  motorcycle   motorcycle       @relation(fields: [motorcycleId], references: [id], map: "Reminder_motorcycleId_fkey")
  service      service?         @relation(fields: [serviceId], references: [id], map: "Reminder_serviceId_fkey")

  @@index([clientId], map: "Reminder_clientId_fkey")
  @@index([motorcycleId], map: "Reminder_motorcycleId_fkey")
  @@index([serviceId], map: "Reminder_serviceId_fkey")
}

model service {
  id                   Int                     @id @default(autoincrement())
  name                 String
  description          String?
  basePrice            Decimal                 @db.Decimal(10, 2)
  durationMinutes      Int?
  maintenanceRule      service_maintenanceRule @default(NONE)
  maintenanceValue     Int?
  vehicleType          service_vehicleType     @default(MOTO)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @default(now()) @updatedAt
  promotion            promotion[]
  reminder             reminder[]
  workorderserviceitem workorderserviceitem[]

  @@index([vehicleType], map: "idx_service_vehicleType")
}

model user {
  id          Int         @id @default(autoincrement())
  email       String      @unique(map: "User_email_key")
  password    String
  name        String
  role        user_role   @default(USER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  lastLoginAt DateTime?
  status      user_status @default(ACTIVE)
}

model workorder {
  id                   Int                    @id @default(autoincrement())
  code                 String                 @unique(map: "WorkOrder_code_key")
  clientId             Int
  motorcycleId         Int
  status               workorder_status       @default(INGRESADO)
  notes                String?
  date                 DateTime               @default(now())
  subtotal             Decimal                @default(0.00) @db.Decimal(10, 2)
  total                Decimal                @default(0.00) @db.Decimal(10, 2)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  client               client                 @relation(fields: [clientId], references: [id], map: "WorkOrder_clientId_fkey")
  motorcycle           motorcycle             @relation(fields: [motorcycleId], references: [id], map: "WorkOrder_motorcycleId_fkey")
  workorderextraitem   workorderextraitem[]
  workorderserviceitem workorderserviceitem[]

  @@index([clientId], map: "WorkOrder_clientId_fkey")
  @@index([motorcycleId], map: "WorkOrder_motorcycleId_fkey")
}

model workorderextraitem {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  name        String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)
  workorder   workorder @relation(fields: [workOrderId], references: [id], map: "WorkOrderExtraItem_workOrderId_fkey")

  @@index([workOrderId], map: "WorkOrderExtraItem_workOrderId_fkey")
}

model workorderserviceitem {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  serviceId   Int
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)
  service     service   @relation(fields: [serviceId], references: [id], map: "WorkOrderServiceItem_serviceId_fkey")
  workorder   workorder @relation(fields: [workOrderId], references: [id], map: "WorkOrderServiceItem_workOrderId_fkey")

  @@index([serviceId], map: "WorkOrderServiceItem_serviceId_fkey")
  @@index([workOrderId], map: "WorkOrderServiceItem_workOrderId_fkey")
}

enum user_role {
  ADMIN
  USER
}

enum workorder_status {
  INGRESADO
  EN_PROGRESO
  LISTO
  ENTREGADO
}

enum client_membership {
  BASIC
  VIP
  PREMIUM
}

enum reminder_channel {
  WHATSAPP
  EMAIL
}

enum service_maintenanceRule {
  NONE
  BY_MONTHS
  BY_KM
  BY_DAYS
  BY_HOURS
}

enum promotion_benefitType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SERVICE
}

enum reminder_status {
  PENDIENTE
  ENVIADO
  COMPLETADO
}

enum service_vehicleType {
  MOTO
  ATV
}

enum motorcycle_type {
  MOTO
  ATV
}

enum user_status {
  ACTIVE
  INACTIVE
}
